                { title: "Infogérance, Maintenance et Supervision", desc: "Suivi en temps réel de la santé de vos réseaux et interventions." },
                { title: "Formation et Documentation", desc: "Transfert de compétences et schémas d'architecture complets." }
              ].map((item, index) => (
                <div key={index} className="group bg-white/5 border border-white/10 backdrop-blur-md p-6 rounded-3xl flex items-start gap-4 transition-all duration-300 hover:border-cyan-500/30 hover:bg-white/[0.08]">
